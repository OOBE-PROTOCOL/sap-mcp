{
  "root": "src",
  "domains": {
    "core": ["core"],
    "schemas": ["schemas"],
    "mcp-adapter": ["adapters/mcp"],
    "solana-adapter": ["adapters/solana", "solana"],
    "adapters": ["adapters/index.ts"],
    "ui-cards": ["ui"],
    "config": ["config"],
    "policy": ["policy"],
    "security": ["security"],
    "signer": ["signer"],
    "payments": ["payments"],
    "memory": ["memory"],
    "premium": ["premium"],
    "sap-domain": ["sap"],
    "session": ["session"],
    "resources": ["resources"],
    "prompts": ["prompts"],
    "tools": ["tools", "perps", "strategies"],
    "server": ["server"],
    "remote-server": ["remote", "transports/http.ts"],
    "local-bridge": ["local-bridge", "bin", "transports/stdio.ts", "runtime"],
    "wizard": ["tui", "wizard-core", "config/wizard.ts", "config-cli.ts"],
    "cli": ["cli.ts", "index.ts"],
    "transports": ["transports"],
    "observability": ["observability"],
    "types": ["types"]
  },
  "allowed": {
    "core": [],
    "schemas": ["core"],
    "ui-cards": ["core"],
    "mcp-adapter": ["core", "ui-cards", "payments", "security", "tools", "observability"],
    "solana-adapter": ["core"],
    "adapters": ["mcp-adapter", "solana-adapter"],
    "config": ["core"],
    "policy": ["core"],
    "security": ["core"],
    "signer": ["core", "config", "policy", "security", "tools"],
    "payments": ["core", "config", "signer", "mcp-adapter", "tools"],
    "memory": ["core", "config"],
    "premium": ["core"],
    "sap-domain": ["core", "signer"],
    "session": ["core"],
    "resources": ["core", "mcp-adapter", "sap-domain", "config", "memory"],
    "prompts": ["core", "mcp-adapter", "config"],
    "tools": ["core", "mcp-adapter", "ui-cards", "config", "policy", "security", "signer", "payments", "memory", "premium", "sap-domain", "schemas", "session", "solana-adapter", "server", "local-bridge"],
    "server": ["core", "mcp-adapter", "config", "policy", "signer", "sap-domain", "tools", "resources", "prompts", "solana-adapter"],
    "remote-server": ["core", "config", "server", "payments", "premium", "memory", "tools"],
    "local-bridge": ["core", "config", "server", "payments", "transports", "runtime"],
    "wizard": ["core", "config", "local-bridge"],
    "cli": ["core", "config", "server", "local-bridge", "remote-server", "sap-domain", "signer", "policy", "tools", "resources", "prompts"]
  },
  "ignoreDomains": ["observability", "types", "transports", "runtime"]
}
