    "packages/adapters/src/**/*.ts",
    "packages/bin/src/**/*.ts",
    "packages/memory/src/**/*.ts",
    "packages/observability/src/**/*.ts",
    "packages/perps/src/**/*.ts",
    "packages/policy/src/**/*.ts",
    "packages/premium/src/**/*.ts",
    "packages/prompts/src/**/*.ts",
    "packages/resources/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/sap/src/**/*.ts",
    "packages/security/src/**/*.ts",
    "packages/session/src/**/*.ts",
    "packages/signer/src/**/*.ts",
    "packages/solana/src/**/*.ts",
    "packages/strategies/src/**/*.ts",
    "packages/transports/src/**/*.ts",
