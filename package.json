{
  "name": "@oobe-protocol-labs/sap-mcp-server",
  "version": "0.9.80",
  "mcpName": "ai.oobeprotocol.sap.mcp/sap-mcp",
  "description": "Official MCP gateway for OOBE Protocol SAP — AI agents can interact with SAP identity, registry, reputation, tools, memory, payments, settlement, and proof-of-execution on Solana",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "sap-mcp-server": "dist/src/bin/sap-mcp-server.js",
    "sap-mcp-config": "dist/src/config-cli.js",
    "sap-mcp-wizard": "dist/tui/config-wizard.js",
    "sap-signing-proxy": "dist/src/signer/signing-proxy.js",
    "sap-mcp-remote": "dist/src/bin/sap-mcp-remote.js",
    "sap-mcp-facilitator": "dist/src/payments/oobe-facilitator-server.js",
    "sap-mcp-pay-sh-spec": "dist/src/payments/pay-sh-spec.js",
    "sap-mcp-x402-paid-call": "dist/src/payments/x402-paid-call.js"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "docs",
    "USER_DOCS",
    "config",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json",
    "smithery.config.schema.json",
    ".env.example",
    "config.example.json",
    "config.secure-example.json",
    "config.schema.json",
    "ecosystem.config.example.cjs",
    "vendor/bigint-buffer"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js",
      "require": "./dist/packages/core/src/index.js"
    },
    "./schemas": {
      "types": "./dist/packages/schemas/src/index.d.ts",
      "import": "./dist/packages/schemas/src/index.js",
      "require": "./dist/packages/schemas/src/index.js"
    },
    "./mcp-adapter": {
      "types": "./dist/packages/mcp-adapter/src/index.d.ts",
      "import": "./dist/packages/mcp-adapter/src/index.js",
      "require": "./dist/packages/mcp-adapter/src/index.js"
    },
    "./ui-cards": {
      "types": "./dist/packages/ui-cards/src/index.d.ts",
      "import": "./dist/packages/ui-cards/src/index.js",
      "require": "./dist/packages/ui-cards/src/index.js"
    },
    "./tools": {
      "types": "./dist/packages/tools/src/index.d.ts",
      "import": "./dist/packages/tools/src/index.js",
      "require": "./dist/packages/tools/src/index.js"
    },
    "./config-runtime": {
      "types": "./dist/packages/config-runtime/src/index.d.ts",
      "import": "./dist/packages/config-runtime/src/index.js",
      "require": "./dist/packages/config-runtime/src/index.js"
    },
    "./server-runtime": {
      "types": "./dist/packages/server-runtime/src/index.d.ts",
      "import": "./dist/packages/server-runtime/src/index.js",
      "require": "./dist/packages/server-runtime/src/index.js"
    },
    "./hosted-gateway": {
      "types": "./dist/packages/hosted-gateway/src/index.d.ts",
      "import": "./dist/packages/hosted-gateway/src/index.js",
      "require": "./dist/packages/hosted-gateway/src/index.js"
    },
    "./local-bridge": {
      "types": "./dist/packages/local-bridge/src/index.d.ts",
      "import": "./dist/packages/local-bridge/src/index.js",
      "require": "./dist/packages/local-bridge/src/index.js"
    },
    "./wizard-core": {
      "types": "./dist/packages/wizard-core/src/desktop-flow.d.ts",
      "import": "./dist/packages/wizard-core/src/desktop-flow.js",
      "require": "./dist/packages/wizard-core/src/desktop-flow.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc && tsc -p tsconfig.tui.json && pnpm run build:packages && pnpm run build:compat",
    "build:compat": "node scripts/create-dist-compat-symlinks.mjs",
    "build:core": "tsc",
    "build:tui": "tsc -p tsconfig.tui.json",
    "desktop:renderer": "vite --config apps/desktop/vite.config.ts",
    "desktop:renderer:build": "vite build --config apps/desktop/vite.config.ts",
    "desktop:build": "pnpm run build && pnpm run desktop:renderer:build && electron-builder --config apps/desktop/electron-builder.cjs --publish never",
    "desktop:verify-artifact": "node scripts/verify-desktop-artifact.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "config": "tsx src/config-cli.ts",
    "tui:config": "tsx src/tui/config-wizard.tsx",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src/ packages/*/src/ --no-error-on-unmatched-pattern",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:workspace-packages": "node scripts/verify-workspace-packages.mjs",
    "verify:package-boundaries": "node scripts/verify-package-boundaries.mjs",
    "verify:circular-deps": "npx madge --circular --extensions ts packages/*/src/ src/*.ts",
    "verify:tool-plugin-template": "pnpm --filter @oobe-protocol-labs/sap-mcp-tool-plugin-template run verify",
    "verify:tool-execution-pipeline": "node scripts/verify-tool-execution-pipeline.mjs",
    "verify:skill-workflows": "node scripts/verify-skill-workflows.mjs",
    "verify:company-readiness": "node scripts/verify-company-readiness.mjs",
    "verify:tool-modules": "tsx scripts/verify-tool-modules.ts",
    "verify:readiness-report": "tsx scripts/build-readiness-report.ts --check",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:release:offline": "pnpm run typecheck && pnpm run lint && pnpm run check:architecture && pnpm run verify:tool-modules && pnpm run verify:workspace-packages && pnpm run verify:package-boundaries && pnpm run verify:tool-plugin-template && pnpm run verify:tool-execution-pipeline && pnpm run verify:skill-workflows && pnpm run verify:company-readiness && pnpm run verify:readiness-report && pnpm run test:run && pnpm run build && pnpm run verify:exports && npm pack --dry-run --cache ./.npm-cache",
    "verify:release": "pnpm run verify:release:offline && pnpm audit --audit-level moderate --prod",
    "version:bump": "node scripts/bump-version.mjs",
    "clean": "rm -rf dist",
    "build:packages": "tsc -p tsconfig.packages.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "sap",
    "synapse",
    "oobe",
    "agent",
    "ai",
    "blockchain"
  ],
  "author": "OOBE Protocol Labs",
  "license": "MIT",
  "homepage": "https://mcp.sap.oobeprotocol.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OOBE-PROTOCOL/sap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/OOBE-PROTOCOL/sap-mcp/issues"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@langchain/core": "^0.3.80",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@oobe-protocol-labs/synapse-client-sdk": "^2.0.6",
    "@oobe-protocol-labs/synapse-sap-sdk": "^1.0.3",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "0.3.8",
    "@solana/sysvars": "^5.5.1",
    "@solana/web3.js": "^1.95.0",
    "@types/better-sqlite3": "^7.6.13",
    "@x402/core": "^2.17.0",
    "@x402/express": "^2.17.0",
    "@x402/svm": "^2.17.0",
