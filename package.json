    "@oobe-protocol-labs/sap-mcp-mcp-adapter": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-transports": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-resources": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-runtime": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-solana": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-observability": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-schemas": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-adapters": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-server-runtime": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-config-runtime": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-prompts": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-wizard-core": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-perps": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-ui-cards": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-local-bridge": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-tool-plugin-template": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-premium": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-policy": "workspace:*",
