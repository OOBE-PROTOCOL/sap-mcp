{
  "name": "@oobe-protocol-labs/sap-mcp-wizard-core",
  "version": "0.9.74",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Internal SAP MCP shared CLI and desktop wizard flow boundary.",
  "sapMcp": {
    "boundaryId": "wizard-core",
    "source": "packages/wizard-core/src",
    "architectureDomain": "wizard",
    "rootExport": "./wizard-core",
    "apiContract": "config/package-export-contracts.json#./wizard-core",
    "boundary": "Shared CLI and desktop wizard flow boundary.",
    "legacyCompatibilitySource": "src/wizard-core",
    "physicalSource": true
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.packages.json --noEmit"
  },
  "exports": {
    "./desktop-flow": {
      "types": "./src/desktop-flow.ts",
      "default": "./src/desktop-flow.ts"
    }
  },
  "dependencies": {
    "@oobe-protocol-labs/sap-mcp-config-runtime": "workspace:*"
  }
}
