{
  "name": "@oobe-protocol-labs/sap-mcp-strategies",
  "version": "0.9.80",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "SAP MCP strategies module \u2014 internal workspace package.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sapMcp": {
    "boundaryId": "strategies",
    "source": "packages/strategies/src",
    "architectureDomain": "strategies",
    "boundary": "Strategy store and trade journal.",
    "legacyCompatibilitySource": "src/strategies",
    "physicalSource": true
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.packages.json --noEmit"
  },
  "exports": {
    "./strategy-store": {
      "types": "./src/strategy-store.ts",
      "default": "./src/strategy-store.ts"
    },
    "./trade-journal": {
      "types": "./src/trade-journal.ts",
      "default": "./src/trade-journal.ts"
    }
  },
  "dependencies": {
    "@oobe-protocol-labs/sap-mcp-config-runtime": "workspace:*",
    "@oobe-protocol-labs/sap-mcp-core": "workspace:*"
  }
}