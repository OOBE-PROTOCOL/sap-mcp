{
  "name": "@oobe-protocol-labs/sap-mcp-security",
  "version": "0.9.80",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "SAP MCP security module \u2014 internal workspace package.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sapMcp": {
    "boundaryId": "security",
    "source": "packages/security/src",
    "architectureDomain": "security",
    "boundary": "Private key guard, tool permissions, prompt injection notes, and approval gates.",
    "legacyCompatibilitySource": "src/security",
    "physicalSource": true
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.packages.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./private-key-guard": {
      "types": "./src/private-key-guard.ts",
      "default": "./src/private-key-guard.ts"
    },
    "./tool-permissions": {
      "types": "./src/tool-permissions.ts",
      "default": "./src/tool-permissions.ts"
    },
    "./prompt-injection-notes": {
      "types": "./src/prompt-injection-notes.ts",
      "default": "./src/prompt-injection-notes.ts"
    },
    "./approval-required": {
      "types": "./src/approval-required.ts",
      "default": "./src/approval-required.ts"
    },
    "./unsafe-action-guard": {
      "types": "./src/unsafe-action-guard.ts",
      "default": "./src/unsafe-action-guard.ts"
    }
  },
  "dependencies": {
    "@oobe-protocol-labs/sap-mcp-core": "workspace:*"
  }
}